{
  // Cloudflare Worker config. The Worker serves ./public and handles /api/* (see src/worker.js).
  "name": "bulkbook",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  // [Unverified] Whether @clerk/backend needs this flag on Workers. It is harmless to keep.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Only /api/* runs the Worker. Static files are served directly (they do not count as Worker requests).
    "run_worker_first": ["/api/*"]
  },
  // Daily clean-up of old, fully paid receipts. Time is UTC (03:00).
  "triggers": { "crons": ["0 3 * * *"] }
  // NO secrets here. Set them with `npx wrangler secret put NAME` (see README step 8).
}
